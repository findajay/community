# Postgres connection string — free tier at https://neon.tech (pick an EU region)
DATABASE_URL=postgres://user:password@host/dbname

# Resend API key — free tier at https://resend.com (3,000 emails/month)
# Leave unset in local dev: confirm links are logged to the console instead.
RESEND_API_KEY=

# Verified sender for Resend (verify your domain in the Resend dashboard)
EMAIL_FROM=MatchBrief <hello@yourdomain.de>

# Public URL of the deployed site, used in confirmation links
PUBLIC_BASE_URL=http://localhost:3000
